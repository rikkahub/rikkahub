<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!--
    Trust user-installed CAs in addition to system CAs so self-hosted providers,
    MCP servers and search endpoints signed by a private CA work.
    Cleartext stays allowed here because android:usesCleartextTraffic is ignored
    once a network security config is present.
  -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
